# Copie para .env e preencha. Nunca versione o .env.

# LLM (Fase 0/3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Banco de dados (PostgreSQL do docker-compose)
DATABASE_URL=postgresql+psycopg://contratolens:contratolens@localhost:5432/contratolens

# Pasta dos PDFs baixados (fora do git e, de preferência, fora do OneDrive)
DATA_DIR=D:\contratolens-data

# Coleta do PNCP
PNCP_MIN_INTERVAL_SECONDS=2.0

# Logs
LOG_LEVEL=INFO
